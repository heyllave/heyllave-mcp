      "type": "streamable-http",
      "url": "https://mcp.heyllave.co/api/v1/agent/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr",
              "registrationUrl": "https://mcp.heyllave.co/api/v1/auth/oauth2/register"
